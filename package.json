{
  "name": "importproof",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5187 --strictPort",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 5187 --strictPort",
    "server": "node --env-file-if-exists=.env --import tsx server/index.ts",
    "test": "tsx --test tests/*.test.ts",
    "benchmark": "tsx scripts/benchmark.ts",
    "replay": "tsx scripts/replay.ts",
    "evaluate:mappings": "tsx scripts/evaluate-mappings.ts"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "fflate": "^0.8.2",
    "papaparse": "^5.5.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "@types/papaparse": "^5.3.16",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.1.1",
    "prettier": "^3.9.9",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "vite": "8.2.2"
  }
}
